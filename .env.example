# Copy to .env and fill in values. Never commit real secrets.

# --- Core ---
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_CORS_ORIGINS=http://localhost:3000
API_PREFIX=/api/v1

# --- Database (PostgreSQL in production and Docker Compose) ---
DATABASE_URL=postgresql+psycopg://campus:campus@localhost:5432/campusmatch

# --- Auth cookies ---
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ACCESS_TOKEN_EXPIRE_MINUTES=60
CSRF_COOKIE_NAME=csrf_token
AUTH_COOKIE_NAME=access_token

# --- Storage ---
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/resumes
RESUME_MAX_BYTES=5242880
# S3-compatible (production)
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# --- AI matching ---
EMBEDDING_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Optional local path for offline/cached models
EMBEDDING_MODEL_PATH=
# Do not block API startup while the model loads
EMBEDDING_LAZY_LOAD=true

# Optional LLM explanations (core matching works without this)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20

# Optional OCR for scanned PDFs
OCR_ENABLED=false

# --- Email (optional) ---
EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@localhost
APP_PUBLIC_URL=http://localhost:3000

# --- Seed (never enable in production) ---
ALLOW_DEV_SEED=false
